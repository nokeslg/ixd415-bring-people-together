{
  "name": "tablemates",
  "version": "0.2.0",
  "private": true,
  "description": "Tablemates: a live group lobby (PartyServer on Cloudflare)",
  "scripts": {
    "build": "esbuild client/client.ts --bundle --format=esm --outfile=public/dist/client.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
