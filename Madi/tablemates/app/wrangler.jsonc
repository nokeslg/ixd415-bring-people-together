{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tablemates",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "Lobby", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }]
}
